      "animations": [
        "q.look('body', 0.5, 0.5)",
        "q.bedrock('atlas_sweep18_crobat', 'ground_idle')"
      ],
        "quirks": ["q.bedrock_quirk('atlas_sweep18_crobat', 'blink')"],
      "transformTicks": 10
    },
    "walk": {
      "poseTypes": ["WALK"],
      "animations": [
        "q.look('body', 0.5, 0.5)",
        "q.bedrock('atlas_sweep18_crobat', 'ground_walk')"
      ],
        "quirks": ["q.bedrock_quirk('atlas_sweep18_crobat', 'blink')"],
      "transformTicks": 5
    },
    "hover": {
      "poseTypes": ["HOVER"],
      "isBattle": false,
      "animations": [
        "q.pitch_tilt('body', 1)",
        "q.look('body', 0.5, 0.5)",
        "q.bedrock('atlas_sweep18_crobat', 'air_idle')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('atlas_sweep18_crobat', 'ride_air_idle')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_sweep18_crobat', 'blink')"
      ],
      "transformTicks": 5
      },
    "fly": {
      "poseTypes": ["FLY"],
      "condition": "!q.is_gliding",
      "isBattle": false,
      "animations": [
        "q.pitch_tilt('body', 1)",
        "q.bedrock('atlas_sweep18_crobat', 'air_fly')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('atlas_sweep18_crobat', 'ride_air_fly')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_sweep18_crobat', 'blink')"
      ],
      "transformTicks": 5
    },
    "glide": {
      "poseTypes": ["FLY"],
      "condition": "q.is_gliding",
      "animations": [
        "q.look('head')",
        "q.bedrock('atlas_sweep18_crobat', 'air_glide')",
        "q.bedrock('atlas_sweep18_crobat', 'ride_dive')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('atlas_sweep18_crobat', 'ride_air_glide')"
        }
      ]
    },
      "sleep": {
        "poseTypes": ["SLEEP"],
        "animations": ["q.bedrock('atlas_sweep18_crobat', 'sleep')"],
        "namedAnimations": {
          "cry": "q.bedrock_stateful('dummy', 'cry')"
      }
    }
