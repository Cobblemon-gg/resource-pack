{
  "portraitScale": 1.8,
  "portraitTranslation": [
    -0.25,
    3.3,
    0
  ],
  "profileScale": 0.45,
  "profileTranslation": [
    0.0,
    1.25,
    0
  ],
  "rootBone": "dragapult",
  "firstPersonCameraOffset": {
    "seat_1": [
      0,
      0.45,
      0
    ]
  },
  "thirdPersonCameraOffset": {
    "seat_1": [
      0,
      0.25,
      0
    ],
    "seat_1_reverse": [
      0,
      0.25,
      0
    ]
  },
  "thirdPersonCameraOffsetNoViewBobbing": {
    "seat_1": [
      0,
      0.25,
      0
    ],
    "seat_1_reverse": [
      0,
      0.25,
      0
    ]
  },
  "animations": {
    "cry": "q.bedrock_stateful('atlas_shadow_dragapult_dragapult', 'cry')",
    "recoil": "q.bedrock_stateful('atlas_shadow_dragapult_dragapult', 'recoil')",
    "physical": "q.bedrock_primary('atlas_shadow_dragapult_dragapult', 'physical', q.curve('symmetrical_wide'))",
    "special": "q.bedrock_primary('atlas_shadow_dragapult_dragapult', 'special', q.curve('symmetrical_wide'))",
    "dragondarts": "q.bedrock_primary('atlas_shadow_dragapult_dragapult', 'special', q.curve('symmetrical_wide'))"
  },
  "poses": {
    "battle-standing": {
      "poseTypes": [
        "STAND",
        "HOVER"
      ],
      "isBattle": true,
      "animations": [
        "q.pitch_tilt('body')",
        "q.look('head')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'battle_idle')"
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink2')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink3')"
      ]
    },
    "water-jump": {
      "poseTypes": [
        "FLOAT",
        "SWIM"
      ],
      "condition": "q.is_ridden",
      "isTouchingWater": false,
      "animations": [
        "q.look('head')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'air_glide')"
      ]
    },
    "standing": {
      "poseTypes": [
        "STAND",
        "NONE",
        "PORTRAIT",
        "PROFILE"
      ],
      "isBattle": false,
      "animations": [
        "q.look('head')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'ground_idle')"
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink2')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink3')"
      ]
    },
    "walking": {
      "poseTypes": [
        "WALK"
      ],
      "condition": "!q.in_air && !q.is_sprinting",
      "animations": [
        "q.look('head')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'ground_walk')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('atlas_shadow_dragapult_dragapult', 'ride_ground_walk')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink2')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink3')"
      ],
      "transformTicks": 10
    },
    "running": {
      "poseTypes": [
        "WALK"
      ],
      "condition": "!q.in_air && q.is_sprinting",
      "animations": [
        "q.look('head')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'ground_run')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('atlas_shadow_dragapult_dragapult', 'ride_ground_run')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink2')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink3')"
      ],
      "transformTicks": 10
    },
    "hover": {
      "poseTypes": [
        "HOVER"
      ],
      "isBattle": false,
      "animations": [
        "q.look('head')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'ground_idle')"
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink2')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink3')"
      ]
    },
    "fly-fast": {
      "poseTypes": [
        "FLY"
      ],
      "isBattle": false,
      "condition": "!q.in_air && q.horizontal_velocity > 0.75",
      "animations": [
        "q.pitch_tilt('body')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'air_glide')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('atlas_shadow_dragapult_dragapult', 'ride_air_glide')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink2')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink3')"
      ],
      "transformTicks": 10,
      "transformToTicks": 10
    },
    "fly": {
      "poseTypes": [
        "FLY"
      ],
      "condition": "q.horizontal_velocity < 0.75",
      "isBattle": false,
      "animations": [
        "q.look('head')",
        "q.pitch_tilt('body')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'air_fly')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('atlas_shadow_dragapult_dragapult', 'ride_air_fly')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink2')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink3')"
      ],
      "transformTicks": 10
    },
    "float": {
      "poseTypes": [
        "FLOAT"
      ],
      "isTouchingWater": true,
      "isBattle": false,
      "animations": [
        "q.look('head')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'ground_walk')"
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink2')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink3')"
      ]
    },
    "swim": {
      "poseTypes": [
        "SWIM"
      ],
      "isTouchingWater": true,
      "isBattle": false,
      "animations": [
        "q.pitch_tilt('body')",
        "q.look('head')",
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'air_fly')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('atlas_shadow_dragapult_dragapult', 'ride_air_fly')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink2')",
        "q.bedrock_quirk('atlas_shadow_dragapult_dragapult', 'blink3')"
      ]
    },
    "sleep": {
      "poseTypes": [
        "SLEEP"
      ],
      "namedAnimations": {
        "cry": "q.bedrock_stateful('dummy', 'cry')"
      },
      "animations": [
        "q.bedrock('atlas_shadow_dragapult_dragapult', 'sleep')"
      ]
    }
  }
}
